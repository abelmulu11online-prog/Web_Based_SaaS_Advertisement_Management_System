# Backend environment variable template
# Copy to backend/.env and fill in real values — never commit the actual .env

PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=advertising_platform
DB_USER=postgres
DB_PASSWORD=changeme

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173

# File storage (S3-compatible — Phase 9)
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
