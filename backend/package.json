{
  "name": "local-discovery-backend",
  "version": "0.1.0",
  "description": "Node.js + Express API for the Local Discovery & Self-Advertising Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src/",
    "test": "node --test tests/api.test.js tests/schema.test.js",
    "test:run": "node --test tests/api.test.js tests/schema.test.js",
    "db:migrate": "node database/migrate.js",
    "db:migrate:status": "node database/migrate.js --status",
    "db:seed": "node database/seed.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "helmet": "7.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "eslint": "9.39.5"
  },
  "engines": {
    "node": ">=18"
  }
}
