# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────
# Option A: full connection URL (takes precedence when set)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres
# Option B: individual fields (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=local_discovery
DB_USER=postgres
DB_PASSWORD=root

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set this explicitly — do NOT leave it as *.
CORS_ORIGINS=http://localhost:5173

# ── JWT (Phase 4 — Authentication) ────────────────────────────────
# Required in production. Generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-string-before-production
JWT_EXPIRES_IN=7d

# ── Email Verification (Phase 4 — Email Verification) ───────────────
# How long verification tokens are valid (e.g., '24h', '1h', '30m')
EMAIL_VERIFICATION_EXPIRES_IN=24h

# ── Password Reset (Phase 4 — Password Reset) ────────────────────────
# How long password reset tokens are valid (e.g., '1h', '30m')
# Shorter than email verification for security
PASSWORD_RESET_EXPIRES_IN=1h

# Frontend URL for verification and reset links
FRONTEND_URL=http://localhost:5173

# ── SMTP Configuration (Email Delivery) ─────────────────────────────
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@localdiscovery.com

# ── Chapa (Phase 6 — Ethiopian Payment Gateway) ──────────────────────
# Register at https://dashboard.chapa.co to get these credentials.
#
# CHAPA_SECRET_KEY:
#   Your Chapa API secret key.
#   Sandbox (testing): starts with  CHASECK_test_...
#   Production (live):  starts with  CHASECK_live_...
#   Used in every API call your server makes TO Chapa.
#   NEVER expose this key in frontend code or API responses.
CHAPA_SECRET_KEY=CHASECK_test_your_key_here

# CHAPA_WEBHOOK_SECRET:
#   A string YOU choose and paste into the Chapa dashboard.
#   Go to: Dashboard → Developer → Webhooks → add your endpoint → set secret.
#   Chapa signs every webhook it sends using this secret.
#   Your server uses it to verify that a webhook truly came from Chapa.
#   NEVER expose this value in API responses or logs.
CHAPA_WEBHOOK_SECRET=your_webhook_secret_string_here
