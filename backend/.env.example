# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────
# Option A: full connection URL (takes precedence when set)
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/local_discovery

# Option B: individual fields (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=local_discovery
DB_USER=postgres
DB_PASSWORD=changeme

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set this explicitly — do NOT leave it as *.
CORS_ORIGINS=http://localhost:5173

# ── JWT (Phase 4 — Authentication) ────────────────────────────────
# Required in production. Generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-string-before-production
JWT_EXPIRES_IN=7d
