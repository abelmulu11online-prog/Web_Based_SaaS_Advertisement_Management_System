# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — project: zldifznsngefciqfxded
# Note: @ in the password is encoded as %40 in the URL
# Supabase PostgreSQL — connection pooler (IPv4, port 5432)
# Project: zldifznsngefciqfxded | Region: us-west-1
DATABASE_URL=postgresql://postgres.zldifznsngefciqfxded:nathypapa211@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-before-production
JWT_EXPIRES_IN=7d

# ── Refresh Token ─────────────────────────────────────────────────────────────
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Email Verification ────────────────────────────────────────────────────────
EMAIL_VERIFICATION_EXPIRES_IN=24h

# ── Password Reset ────────────────────────────────────────────────────────────
PASSWORD_RESET_EXPIRES_IN=1h

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── SMTP (Email Delivery) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@localdiscovery.com

# ── Chapa (Ethiopian Payment Gateway) ────────────────────────────────────────
